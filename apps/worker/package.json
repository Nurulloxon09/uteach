    "@uteach/i18n": "workspace:*",
    "@uteach/receipts": "workspace:*",
    "grammy": "1.46.0",
    "intl-messageformat": "11.2.15",
    "libphonenumber-js": "1.13.15",
    "postgres": "3.4.7",
    "react": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@uteach/config": "workspace:*",
    "eslint": "9.39.5",
