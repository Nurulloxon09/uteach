{
  "name": "uteach",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:i18n": "npm run check --workspace=@uteach/i18n",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/src/database.types.ts",
    "e2e": "supabase db reset && npm run e2e --workspace=apps/web",
    "screenshots": "supabase db reset && npm run screenshots --workspace=apps/web",
    "db:test:lite": "node scripts/db-test-lite.mjs supabase",
    "dev:access": "node scripts/dev-owner-access.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgtap": "0.0.9",
    "prettier": "3.9.9",
    "supabase": "2.120.0",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}