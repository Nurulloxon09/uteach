# Copy to docker/.env on the server. Never commit the real file.
SITE_DOMAIN=app.example.com
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SEND_SMS_HOOK_SECRET=
SMS_PROVIDER=console
# SMS hook with Eskiz (web): the secret key is used only for the per-phone OTP limit.
# SUPABASE_SECRET_KEY=
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_FROM=4546

# Worker (M4): its own database login (role uteach_worker; the owner sets its password) and the bot token.
WORKER_DATABASE_URL=postgresql://uteach_worker:<password>@<host>:5432/postgres
TELEGRAM_BOT_TOKEN=
