# Copy to .env.local. Values below match `pnpm db:start` (see `supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The anon / publishable key printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_COUNTRY=UZ
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Tashkent

# Must equal [auth.hook.send_sms].secrets in supabase/config.toml (local dev value).
SEND_SMS_HOOK_SECRET=v1,whsec_1+qqtIntNTfgrrK8q3OAyOC+OIELxbxjMkBFqCbl2UU=
# console (dev) | eskiz (from M4)
SMS_PROVIDER=console
