# Copy to apps/worker/.env.local for `pnpm --filter @uteach/worker dev` (tsx loads it with --env-file).
# Local Supabase: the uteach_worker password comes from supabase/seed.sql.
WORKER_DATABASE_URL=postgresql://uteach_worker:uteach-worker-local@127.0.0.1:54322/postgres
# The dev bot's token from @BotFather. Never commit it or paste it in chat.
TELEGRAM_BOT_TOKEN=
# console (prints SMS to the log) | eskiz (also set ESKIZ_EMAIL, ESKIZ_PASSWORD, optional ESKIZ_FROM)
SMS_PROVIDER=console
# SEND_INTERVAL_MS=5000
