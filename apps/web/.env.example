# Copy to .env.local. Values below match `pnpm db:start` (see `supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The anon / publishable key printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_COUNTRY=UZ
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Tashkent
# The bot's username without @ (the dev bot locally), for the center's deep link and QR code.
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# uteach's own Telegram username without @, shown as the contact on the landing page (hidden when unset).
# NEXT_PUBLIC_CONTACT_TELEGRAM=
# Set to true only in production so search engines may index the public pages.
# NEXT_PUBLIC_SITE_INDEXABLE=

# Must equal [auth.hook.send_sms].secrets in supabase/config.toml (local dev value).
SEND_SMS_HOOK_SECRET=v1,whsec_1+qqtIntNTfgrrK8q3OAyOC+OIELxbxjMkBFqCbl2UU=
# console (dev) | eskiz (staging/production; also set ESKIZ_* and SUPABASE_SECRET_KEY)
SMS_PROVIDER=console
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_FROM=4546
# The secret (service-role) key; only the SMS hook uses it, for the 5-codes-per-hour limit per phone.
# SUPABASE_SECRET_KEY=
# Public base URL used in invite links. Defaults to the request host.
# SITE_URL=http://localhost:3000
